<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dsim_slam</name>
  <version>0.1.0</version>
  <description>
    Depth-camera scan-to-local-map odometry: position and orientation from a
    RealSense D435 point cloud and the IMU gyro, with an honest covariance and
    a TRACKING / DEGRADED / LOST status. Uses only what a real drone carries;
    never reads ground truth.
  </description>
  <maintainer email="banana99ou@gmail.com">JHY</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
